# Copy this file to .env. Replace the placeholder with your Neon connection string.
# Keep .env local; never commit a real database URL or password.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full&channel_binding=require"
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
# Development only: skip the inbox step locally; production always requires verification.
DEV_AUTO_VERIFY_EMAIL=true
# Production email delivery (required when NODE_ENV=production)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Production per-IP limit override; route-specific defaults apply if unset. Development allows 100 per route.
AUTH_RATE_LIMIT=10
# Production per-IP social mutation limit; development defaults to 200 per 15 minutes.
SOCIAL_RATE_LIMIT=45
# Number of trusted proxy hops in front of Express (leave 0 locally; set per host).
TRUST_PROXY_HOPS=0
# Optional; defaults to backend/uploads/avatars. Use persistent storage in production.
AVATAR_UPLOAD_DIR=
